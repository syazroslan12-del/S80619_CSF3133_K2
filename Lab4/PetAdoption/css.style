
/* General Styling */
* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f7f7f0;
    color: #333;
    line-height: 1.6;
}

/* Header */
header {
    background-color: #405b3e;
    color: white;
    text-align: center;
    padding: 35px 20px;
}

header h1 {
    font-size: 38px;
    letter-spacing: 3px;
    margin-bottom: 5px;
}

header p {
    color: #f5d89a;
}

/* Navigation Bar */
nav {
    background-color: #30462f;
}

nav ul {
    list-style-type: none;
    display: flex;
    justify-content: center;
    padding: 0;
    margin: 0;
}

nav li {
    padding: 15px 20px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

/* Link States */
nav a:hover {
    color: #f5d89a;
    text-decoration: underline;
}

nav a:visited {
    color: #d9e8d1;
}

/* Main Content */
main {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

section {
    background-color: white;
    padding: 30px;
    margin-bottom: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

h2 {
    border-bottom: 3px solid #e5c47b;
    padding-bottom: 8px;
}

/* Welcome Section */
.welcome {
    text-align: center;
    background-color: #e9efe3;
    padding: 50px 25px;
}

.welcome p {
    max-width: 650px;
    margin: 20px auto;
}

.adopt-button {
    display: inline-block;
    background-color: #405b3e;
    color: white;
    padding: 12px 25px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
}

.adopt-button:hover {
    background-color: #e5c47b;
    color: #30462f;
}

/* Pet Cards */
.pet-container {
    display: flex;
    gap: 20px;
    justify-content: center;
}

.pet-card {
    flex: 1;
    background-color: #f7f7f0;
    padding: 15px;
    border-radius: 10px;
    text-align: center;
}

.pet-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
}

.pet-card h3 {
    color: #405b3e;
    margin-bottom: 5px;
}

.pet-card p {
    margin: 5px;
}

/* Video Section */
figure {
    margin: 20px 0;
    text-align: center;
}

video {
    width: 100%;
    max-width: 650px;
    border-radius: 10px;
}

figcaption {
    color: #666;
    margin-top: 10px;
    font-size: 14px;
}

/* Adoption Form */
form {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
}

textarea {
    min-height: 100px;
}

button {
    background-color: #405b3e;
    color: white;
    padding: 13px;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background-color: #e5c47b;
    color: #30462f;
}

/* Responsive Design */
@media screen and (max-width: 600px) {

    nav ul {
        flex-direction: column;
        text-align: center;
    }

    nav li {
        padding: 10px;
    }

    header h1 {
        font-size: 28px;
    }

    main {
        padding: 10px;
    }

    section {
        padding: 20px;
    }

    .pet-container {
        flex-direction: column;
    }

    .pet-card img {
        height: 220px;
    }
}
